rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo puede leer/escribir SUS propios datos.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // MODO PRODUCCIÓN: el usuario NO puede otorgarse Pro ni alargar su vencimiento.
      // Solo el webhook de Wompi (cuenta de servicio, que se salta estas reglas) fija
      // "pro" y "proHasta". Se usa .get(campo, valor_por_defecto) porque leer un campo
      // que no existe hace fallar la regla y bloquearía escrituras legítimas.
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.get('pro', false) == false
                    && !('proHasta' in request.resource.data);

      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.get('pro', false) == resource.data.get('pro', false)
                    && request.resource.data.get('proHasta', '') == resource.data.get('proHasta', '');

      // Subcolecciones del usuario: proyectos y metadatos (base APU propia, etc.)
      match /{sub}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
